{
  "expo": {
    "name": "YenDidii",
    "slug": "YenDidii",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yendidii",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#C25327",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show nearby cooks and delivery tracking.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.yendidii.app"
    },
    "android": {
      "package": "com.yendidii.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C25327",
          "dark": {
            "backgroundColor": "#C25327"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#BF592B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc1cce68-325a-4d0d-bc40-cad945565e5e"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/bc1cce68-325a-4d0d-bc40-cad945565e5e",
      "fallbackToCacheTimeout": 0
    }
  }
}
