# EAS Build ignore file
# EAS uses .gitignore by default, this file adds extra exclusions

# Large binary files not needed for builds
jq

# Local development folders
node_modules/
.expo/
dist/
web-build/

# macOS junk
.DS_Store
**/.DS_Store

# macOS AppleDouble resource fork files (cause tar "File exists" errors on Linux)
._*
**/._*
.AppleDouble
.LSOverride

# Local env files (EAS has its own env vars)
.env
.env*.local

# Specific utility/seed scripts not needed for build
*.sql
seed.ts
check_data.ts
check_policies.ts
check_user.ts
meal_sessions_schema.sql
supabase_schema.sql
seed_main_dishes.sql
seed_sessions.sql
seed.sql
update_categories.sql

# Local store (Zustand persist, not needed for build)
store/
store.config.json

# Supabase local config
supabase/

# Editor configs
.vscode/

# Git
.git/

# TypeScript build info
*.tsbuildinfo
expo-env.d.ts
